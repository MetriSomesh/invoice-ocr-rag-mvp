# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004
# Optional overrides
DATABASE_URL=sqlite:///./euniserv.db
CHROMA_DIR=./chroma_db
UPLOAD_DIR=./uploads
# Tesseract / Poppler paths — only set if they are not on PATH
# TESSERACT_CMD=/usr/bin/tesseract
# POPPLER_PATH=/usr/bin
# OCR engine for camera scans: auto (RapidOCR if installed, else Tesseract),
# rapidocr, or tesseract. RapidOCR needs no system binaries; Tesseract does.
OCR_ENGINE=auto
OCR_DPI=300
OCR_LANG=eng
